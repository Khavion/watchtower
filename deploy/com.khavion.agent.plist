<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Khavion watchtower LaunchAgent. install.sh substitutes __REPO__ and
       places the result in ~/Library/LaunchAgents/. Loads at login (survives
       reboot once the user session starts); KeepAlive restarts the daemon on
       crash, throttled to once per 30s. Opens NO ports: the daemon only makes
       outbound requests, and scheduling runs in-process via APScheduler. -->
  <key>Label</key>
  <string>com.khavion.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>pipeline.run</string>
    <string>--daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__REPO__/data/runs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/runs/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
